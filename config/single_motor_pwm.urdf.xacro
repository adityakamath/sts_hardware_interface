<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="single_motor_pwm">

  <!-- Arguments -->
  <xacro:arg name="serial_port" default="/dev/ttyACM0"/>
  <xacro:arg name="motor_id" default="1"/>
  <xacro:arg name="baud_rate" default="1000000"/>
  <xacro:arg name="use_mock" default="false"/>
  <xacro:arg name="max_effort" default="1.0"/>

  <!-- Robot description -->

  <!-- Robot description -->
  <link name="base_link"/>

  <link name="pwm_link"/>

  <!-- continuous: PWM mode is open-loop — no position limits apply.
       Using continuous avoids JointSaturationLimiter clamping effort to 0. -->
  <joint name="pwm_joint" type="continuous">
    <parent link="base_link"/>
    <child link="pwm_link"/>
    <!-- shaft sits 20 mm above the base plate -->
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- effort limit only (no position limits on continuous joint) -->
    <limit effort="1.0" velocity="5.0"/>
  </joint>

  <!-- ros2_control hardware interface -->
  <ros2_control name="sts_system" type="system">
    <hardware>
      <plugin>sts_hardware_interface/STSHardwareInterface</plugin>

      <!-- Required Parameters -->
      <param name="serial_port">$(arg serial_port)</param>  <!-- Serial port path (e.g., /dev/ttyACM0) -->

      <!-- Optional Hardware Parameters (with defaults shown) -->
      <param name="baud_rate">$(arg baud_rate)</param>  <!-- Baud rate: 9600-1000000 (default: 1000000) -->
      <param name="communication_timeout_ms">100</param>  <!-- Serial timeout: 1-1000 ms (default: 100) -->
      <param name="use_sync_write">false</param>  <!-- SyncWrite not needed for single motor -->
      <param name="enable_mock_mode">$(arg use_mock)</param>  <!-- Simulation mode without hardware (default: false) -->
      <param name="max_velocity_steps">3400</param>  <!-- Max motor velocity in steps/s: STS3215=3400, STS3032=2900 (default: 3400) -->
      <param name="reset_states_on_activate">true</param>  <!-- Reset position/velocity to zero on activation (default: true) -->
    </hardware>

    <joint name="pwm_joint">
      <!-- Required Joint Parameters -->
      <param name="motor_id">$(arg motor_id)</param>  <!-- Motor ID on serial bus: 1-253 -->

      <!-- Operating Mode -->
      <param name="operating_mode">2</param>  <!-- 0=Position, 1=Velocity, 2=PWM (open-loop effort) -->

      <!-- Optional: cap maximum PWM duty cycle to a safe fraction of full power -->
      <param name="max_effort">$(arg max_effort)</param>  <!-- Max effort command (0.0, 1.0] — safety limiter; does NOT scale the command (default: 1.0) -->

      <!-- Note: p_coefficient, d_coefficient, i_coefficient are ignored in Mode 2 (no PID) -->

      <!-- Optional EEPROM parameters (omit any line to preserve the existing EEPROM value): -->
      <!-- <param name="protection_current">462</param> -->  <!-- Hardware current cutoff (0-65535, 6.5mA units; 462 ≈ 3.0A): addr 28/29 -->
      <!-- <param name="overload_torque">80</param> -->      <!-- Load threshold for overload protection (0-254): addr 36 -->
      <!-- <param name="return_delay">0</param> -->          <!-- Response delay (0-254, 2µs units): addr 7 -->
      <!-- <param name="deadband">2</param> -->              <!-- Position insensitive-area (0-255): addr 26/27 (CW_DEAD/CCW_DEAD), both set to the same value (Mode 0 only; ignored in Mode 1/2) -->

      <!-- Command Interface (Mode 2: PWM/Effort) -->
      <command_interface name="effort"/>  <!-- PWM duty cycle: -1.0 (full reverse) to +1.0 (full forward); clamped to ±max_effort -->

      <!-- State Interfaces (always exported, declarations optional but recommended) -->
      <state_interface name="position"/>  <!-- Current position (radians) — may drift; open-loop -->
      <state_interface name="velocity"/>  <!-- Current velocity (rad/s) -->
      <state_interface name="effort"/>    <!-- Motor load (-1.0 to +1.0, normalized) -->
      <state_interface name="voltage"/>   <!-- Supply voltage (volts) -->
      <state_interface name="temperature"/>  <!-- Internal temperature (°C) -->
      <state_interface name="current"/>   <!-- Motor current draw (amperes) -->
      <state_interface name="is_moving"/> <!-- Motion status (1.0=moving, 0.0=stopped) -->
    </joint>
  </ros2_control>

</robot>
